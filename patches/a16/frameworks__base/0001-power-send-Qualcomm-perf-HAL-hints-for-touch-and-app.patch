+package com.android.server.power;
+
+import android.os.Handler;
+import android.os.IHwBinder;
+import android.os.Process;
+import android.os.RemoteException;
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.util.Slog;
+
+import com.android.server.ServiceThread;
+
+import vendor.qti.hardware.perf.V2_0.IPerf;
+
+import java.util.ArrayList;
+import java.util.NoSuchElementException;
+
+/**
+ * Sends Qualcomm perf HAL hints for touch and app launch.
+ *
+ * GSIs lack the QTI BoostFramework, and some vendor power HALs report INTERACTION / LAUNCH as
+ * unsupported, so no CPU boost ever happens. This talks to vendor.qti.hardware.perf IPerf
+ * directly, using the hint ids defined in the vendor perfboostsconfig.xml. It is a no-op on
+ * devices without that HAL, and can be disabled with persist.sys.nico.qtiboost=false.
+ */
+final class QtiPerfBooster {
+    private static final String TAG = "QtiPerfBooster";
+    private static final String PROP_ENABLED = "persist.sys.nico.qtiboost";
+
+    // Animation boost: both clusters at max frequency. The pre-fling scroll boost (0x1080 type 4)
+    // only raised the little cluster and left the launcher UI thread at 45% janky frames.
+    private static final int HINT_ANIMATION = 0x00001083;
+    private static final int HINT_LAUNCH = 0x00001081;
+    // Hints declared without a Type in perfboostsconfig.xml only match type -1.
+    private static final int ANIMATION_TYPE_DEFAULT = -1;
+    private static final int LAUNCH_TYPE_MAIN = 1;
+
+    // Long enough to cover the animation that follows the finger lifting (drawer, fling).
+    private static final int TOUCH_BOOST_MS = 400;
+    private static final int LAUNCH_BOOST_MS = 2000;
+    private static final long TOUCH_MIN_INTERVAL_MS = 150;
+    private static final long RECONNECT_BACKOFF_MS = 30_000;
+
+    private static final ArrayList<Integer> NO_RESERVED = new ArrayList<>();
+
+    private final Handler mHandler;
+
+    // All fields below are only touched on mHandler's thread.
+    private IPerf mPerf;
+    private boolean mHalMissing;
+    private long mLastConnectAttempt = -RECONNECT_BACKOFF_MS;
+    private long mLastTouchBoost;
+    private int mLaunchHandle = -1;
+
+    QtiPerfBooster() {
+        ServiceThread thread = new ServiceThread(TAG, Process.THREAD_PRIORITY_DISPLAY,
+                /* allowIo= */ false);
+        thread.start();
+        mHandler = new Handler(thread.getLooper());
+    }
+
+    /** Called for every user activity; boosts only on touch, rate limited. */
+    void onUserActivity(int event) {
+        if (event != android.os.PowerManager.USER_ACTIVITY_EVENT_TOUCH || !isEnabled()) {
+            return;
+        }
+        mHandler.post(this::boostTouch);
+    }
+
+    /** Mirrors PowerManager Mode.LAUNCH, which the vendor power HAL may ignore. */
+    void onLaunchMode(boolean enabled) {
+        if (!isEnabled()) {
+            return;
+        }
+        mHandler.post(() -> {
+            if (enabled) {
+                boostLaunch();
+            } else {
+                releaseLaunch();
+            }
+        });
+    }
+
+    private static boolean isEnabled() {
+        return SystemProperties.getBoolean(PROP_ENABLED, true);
+    }
+
+    private void boostTouch() {
+        long now = SystemClock.uptimeMillis();
+        if (now - mLastTouchBoost < TOUCH_MIN_INTERVAL_MS) {
+            return;
+        }
+        mLastTouchBoost = now;
+        hint(HINT_ANIMATION, TOUCH_BOOST_MS, ANIMATION_TYPE_DEFAULT);
+    }
+
+    private void boostLaunch() {
+        releaseLaunch();
+        mLaunchHandle = hint(HINT_LAUNCH, LAUNCH_BOOST_MS, LAUNCH_TYPE_MAIN);
+    }
+
+    private void releaseLaunch() {
+        if (mLaunchHandle <= 0) {
+            return;
+        }
+        IPerf perf = getPerf();
+        if (perf != null) {
+            try {
+                perf.perfLockRelease(mLaunchHandle, NO_RESERVED);
+            } catch (RemoteException e) {
+                onHalError(e);
+            }
+        }
+        mLaunchHandle = -1;
+    }
+
+    /** Returns the perf lock handle, or -1 when the hint could not be sent. */
+    private int hint(int hintId, int durationMs, int type) {
+        IPerf perf = getPerf();
+        if (perf == null) {
+            return -1;
+        }
+        try {
+            return perf.perfHint(hintId, "", durationMs, type, NO_RESERVED);
+        } catch (RemoteException e) {
+            onHalError(e);
+            return -1;
+        }
+    }
+
+    private IPerf getPerf() {
+        if (mPerf != null || mHalMissing) {
+            return mPerf;
+        }
+        long now = SystemClock.uptimeMillis();
+        if (now - mLastConnectAttempt < RECONNECT_BACKOFF_MS) {
+            return null;
+        }
+        mLastConnectAttempt = now;
+        try {
+            IPerf perf = IPerf.getService(/* retry= */ false);
+            perf.linkToDeath(cookie -> mHandler.post(() -> {
+                Slog.w(TAG, "perf HAL died");
+                mPerf = null;
+                mLaunchHandle = -1;
+            }), 0);
+            mPerf = perf;
+            Slog.i(TAG, "connected to vendor.qti.hardware.perf IPerf");
+        } catch (NoSuchElementException e) {
+            mHalMissing = true;
+            Slog.i(TAG, "vendor.qti.hardware.perf IPerf not present, boosts disabled");
+        } catch (RemoteException e) {
+            Slog.w(TAG, "cannot reach perf HAL", e);
+        }
+        return mPerf;
+    }
+
+    private void onHalError(RemoteException e) {
+        Slog.w(TAG, "perf HAL call failed", e);
+        mPerf = null;
+        mLaunchHandle = -1;
+    }
+}
