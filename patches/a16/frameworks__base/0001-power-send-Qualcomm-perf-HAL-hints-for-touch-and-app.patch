 services/core/Android.bp                      |   1 +
 .../server/power/PowerManagerService.java     |   6 +
 .../android/server/power/QtiPerfBooster.java  | 179 ++++++++++++++++++
 3 files changed, 186 insertions(+)
 create mode 100644 services/core/java/com/android/server/power/QtiPerfBooster.java

